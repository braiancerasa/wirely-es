    { "src": "icons/wirely-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/wirely-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".wirely"] } }
  ]
}
