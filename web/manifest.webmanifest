{
  "name": "Wirely — simulador de circuitos",
  "short_name": "Wirely",
  "description": "Dibuje un circuito, presione Ejecutar y véalo funcionar.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1f6fd1",
  "icons": [
